* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #0b1020;
    color: #f1f5f9;
    line-height: 1.6;
}


/* CABEÇALHO */

header {
    background: linear-gradient(135deg, #111c44, #172b6b);
    text-align: center;
    padding: 60px 20px;
    border-bottom: 3px solid #3b82f6;
}

header h1 {
    font-size: 42px;
    margin-bottom: 10px;
}

header p {
    font-size: 18px;
    color: #cbd5e1;
}


/* MENU */

nav {
    background: #080c18;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    padding: 15px;
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid #1e293b;
}

nav a {
    color: white;
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 8px;
    transition: 0.3s;
}

nav a:hover {
    background: #2563eb;
}


/* CONTEÚDO */

main {
    width: 90%;
    max-width: 1100px;
    margin: auto;
}

section {
    padding: 60px 0;
}

section h2 {
    font-size: 32px;
    color: #60a5fa;
    margin-bottom: 20px;
}

section h3 {
    margin-bottom: 10px;
}


/* INÍCIO */

.inicio {
    text-align: center;
}

.inicio > p {
    max-width: 800px;
    margin: auto;
    color: #cbd5e1;
    font-size: 18px;
}

.objetivo {
    margin: 35px auto;
    max-width: 800px;
    background: #111827;
    padding: 25px;
    border-radius: 15px;
    border-left: 5px solid #3b82f6;
}

.objetivo p {
    color: #cbd5e1;
}


/* CARDS */

.cards-resumo {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 30px;
}

.cards-resumo div {
    background: #111827;
    width: 200px;
    padding: 25px;
    border-radius: 15px;
    border: 1px solid #1e40af;
}

.cards-resumo span {
    display: block;
    font-size: 35px;
    font-weight: bold;
    color: #60a5fa;
}

.cards-resumo p {
    color: #cbd5e1;
}


/* PROBLEMAS */

.problema {
    background: #111827;
    border: 1px solid #263453;
    margin-bottom: 20px;
    border-radius: 15px;
    padding: 25px;
    transition: 0.3s;
}

.problema:hover {
    border-color: #3b82f6;
    transform: translateY(-2px);
}

.problema h3 {
    color: #e2e8f0;
}

.problema button,
.teste button {
    background: #2563eb;
    color: white;
    border: none;
    padding: 11px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 15px;
    margin-top: 10px;
    transition: 0.3s;
}

.problema button:hover,
.teste button:hover {
    background: #1d4ed8;
}

.conteudo {
    display: none;
    margin-top: 25px;
    border-top: 1px solid #334155;
    padding-top: 20px;
}

.conteudo.ativo {
    display: block;
}

.conteudo h4 {
    color: #60a5fa;
    margin-top: 20px;
    margin-bottom: 8px;
}

.conteudo p,
.conteudo li {
    color: #cbd5e1;
}

.conteudo ul,
.conteudo ol {
    margin-left: 25px;
}


/* CÓDIGO */

.codigo {
    background: #020617;
    border: 1px solid #334155;
    padding: 15px;
    margin: 12px 0;
    border-radius: 8px;
    color: #4ade80;
    font-family: "Courier New", monospace;
    font-size: 16px;
}


/* TABELA */

.tabela-container {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    background: #111827;
    border-radius: 10px;
    overflow: hidden;
}

th {
    background: #1d4ed8;
    color: white;
    padding: 15px;
    text-align: left;
}

td {
    padding: 15px;
    border-bottom: 1px solid #263453;
    color: #cbd5e1;
}

tr:hover {
    background: #172033;
}


/* TESTES */

.teste {
    background: #111827;
    border: 1px solid #263453;
    padding: 25px;
    margin: 20px 0;
    border-radius: 15px;
}

.resultado {
    background: #020617;
    border: 1px solid #334155;
    padding: 20px;
    margin-top: 15px;
    border-radius: 8px;
    color: #4ade80;
    font-family: "Courier New", monospace;
}


/* SOLUÇÕES */

.passos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
}

.passos div {
    background: #111827;
    padding: 25px;
    border-radius: 15px;
    border: 1px solid #263453;
}

.passos strong {
    display: block;
    width: 45px;
    height: 45px;
    line-height: 45px;
    text-align: center;
    background: #2563eb;
    border-radius: 50%;
    margin-bottom: 15px;
    font-size: 20px;
}

.passos p {
    color: #cbd5e1;
}


/* DOCUMENTAÇÃO */

.documentacao {
    background: #111827;
    padding: 30px;
    border-radius: 15px;
    border: 1px solid #263453;
}

.print-area {
    margin-top: 20px;
    min-height: 180px;
    border: 2px dashed #475569;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
}

.print-area p {
    font-size: 50px;
}


/* RODAPÉ */

footer {
    background: #020617;
    text-align: center;
    padding: 40px 20px;
    border-top: 1px solid #1e293b;
}

footer h3 {
    color: #60a5fa;
}

footer p {
    color: #94a3b8;
}

.copyright {
    margin-top: 20px;
}


/* RESPONSIVO */

@media (max-width: 700px) {

    header h1 {
        font-size: 30px;
    }

    nav {
        position: static;
    }

    section {
        padding: 40px 0;
    }

    section h2 {
        font-size: 26px;
    }

    .cards-resumo {
        flex-direction: column;
        align-items: center;
    }

    .cards-resumo div {
        width: 100%;
        max-width: 300px;
    }

}
